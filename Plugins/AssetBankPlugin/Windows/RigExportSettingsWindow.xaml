<ctrl:FrostyWindow x:Class="AssetBankPlugin.Windows.RigExportSettingsWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
                   Title="Rig Export Settings" Height="320" Width="480"
                   WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <!-- Import our global styles dictionaries -->
    <ctrl:FrostyWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FrostyControls;component/Themes/Generic.xaml"/>
                <ResourceDictionary Source="/AssetBankPlugin;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ctrl:FrostyWindow.Resources>

    <!-- Moving the WindowBackground here solves an error somehow -->
    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="14">

            <!-- TARGET MESH -->
            <TextBlock Text="TARGET MESH" Foreground="#AAAAAA" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock x:Name="m_meshNameText" Text="No Mesh Selected" Foreground="#E0E0E0" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="#151515" CornerRadius="3" BorderBrush="#333" BorderThickness="1" Height="26">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="m_meshIcon" Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="m_meshPathText" Grid.Column="1" Text="Click Browse..." Foreground="#888888" FontSize="11" 
                                   VerticalAlignment="Center" Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
                <Button Content="Browse" Grid.Column="1" Width="70" Margin="4,0,0,0" 
                        Style="{StaticResource SecondaryActionButton}" Click="BrowseMesh_Click"/>
            </Grid>

            <!-- SEPARATOR -->
            <Border Height="1" Background="#333" Margin="0,0,0,14"/>

            <!-- EXPORT SETTINGS -->
            <TextBlock Text="EXPORT SETTINGS" Foreground="#AAAAAA" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="FBX Version:" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="m_fbxCombo" Grid.Column="1" Height="24" Padding="6,2" FontSize="12" 
                          Background="#1E1E1E" Foreground="White" BorderBrush="#3F3F46" SelectionChanged="FbxCombo_SelectionChanged"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Scale Unit:" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="m_scaleCombo" Grid.Column="1" Height="24" Padding="6,2" FontSize="12" 
                          Background="#1E1E1E" Foreground="White" BorderBrush="#3F3F46" SelectionChanged="ScaleCombo_SelectionChanged"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Mesh Options:" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ToggleButton x:Name="m_singleLodCheck" Content="Export Single LOD (LOD 0)" Grid.Column="1" 
                              Style="{StaticResource ActionToggleButton}" HorizontalAlignment="Stretch"/>
            </Grid>

        </StackPanel>

        <!-- BOTTOM ACTION BAR -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#111" BorderThickness="0,1,0,0" Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Margin="0,0,6,0" IsCancel="True" Click="Cancel_Click" 
                        Style="{StaticResource SecondaryActionButton}"/>
                <Button Content="Export" Width="90" IsDefault="True" Click="Export_Click" 
                        Style="{StaticResource PrimaryActionButton}"/>
            </StackPanel>
        </Border>

    </Grid>
</ctrl:FrostyWindow>