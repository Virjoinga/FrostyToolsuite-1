<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AssetBankPlugin"
    xmlns:win="clr-namespace:AssetBankPlugin.Windows"
    xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
    xmlns:fcore="clr-namespace:Frosty.Core.Controls;assembly=FrostyCore">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostyControls;component/Themes/Generic.xaml"/>
        <ResourceDictionary Source="/AssetBankPlugin;component/Themes/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:AntStateAssetEditor}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AntStateAssetEditor}">
                    <Grid Background="{StaticResource WindowBackground}" DataContext="{RelativeSource TemplatedParent}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6.5*" MinWidth="450"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="3.5*" MinWidth="320"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#252526" BorderBrush="#111"
                                        BorderThickness="0,0,1,1" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Preview Target:" Foreground="#E0E0E0"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Margin="0,0,8,0" FontWeight="SemiBold"/>

                                        <Border Grid.Column="1" Background="#151515" CornerRadius="3"
                                                BorderBrush="#333" BorderThickness="1" Height="24">
                                            <TextBox x:Name="PART_MeshPath"
                                                     Background="Transparent" Foreground="#E0E0E0"
                                                     CaretBrush="White" BorderThickness="0"
                                                     Padding="6,0" VerticalContentAlignment="Center"
                                                     FontSize="12"/>
                                        </Border>

                                        <Button x:Name="PART_MeshUseSelected" Grid.Column="2"
                                                Width="24" Height="24" Margin="4,0,0,0" Padding="0"
                                                Style="{StaticResource SecondaryActionButton}">
                                            <Button.ToolTip>
                                                <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                             Foreground="White" Padding="6,4"
                                                             ToolTipService.HasDropShadow="False">
                                                    <TextBlock Text="Use the asset currently selected in the data explorer" />
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <Image Width="12" Height="12"
                                                   Source="/FrostyEditor;component/Images/Assign.png"
                                                   RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="-1"/>
                                                </Image.RenderTransform>
                                            </Image>
                                        </Button>

                                        <Button x:Name="PART_MeshLoad" Grid.Column="3"
                                                Margin="4,0,0,0" Padding="12,0" Height="24"
                                                Style="{StaticResource SecondaryActionButton}">
                                            <Button.ToolTip>
                                                <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                             Foreground="White" Padding="6,4"
                                                             ToolTipService.HasDropShadow="False">
                                                    <TextBlock Text="Load this target into the viewport" />
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <TextBlock Text="Load Mesh" VerticalAlignment="Center" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Background="#252526" BorderBrush="#111"
                                        BorderThickness="0,0,1,1" Padding="8,4">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                            <ToggleButton Style="{StaticResource ToolbarToggle}"
                                                          IsChecked="{Binding Path=GroundVisible}"
                                                          DataContext="{Binding Path=Screen, ElementName=PART_Viewport}">
                                                <ToggleButton.ToolTip>
                                                    <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                             Foreground="White" Padding="6,4"
                                                             ToolTipService.HasDropShadow="False">
                                                        <TextBlock Text="Toggle ground plane" />
                                                    </ToolTip>
                                                </ToggleButton.ToolTip>
                                                <Image Width="14" Source="/FrostyEditor;component/Images/Skybox.png"/>
                                            </ToggleButton>
                                            <ToggleButton Style="{StaticResource ToolbarToggle}" Margin="2,0,0,0"
                                                          IsChecked="{Binding Path=GridVisible}"
                                                          DataContext="{Binding Path=Screen, ElementName=PART_Viewport}">
                                                <ToggleButton.ToolTip>
                                                    <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                             Foreground="White" Padding="6,4"
                                                             ToolTipService.HasDropShadow="False">
                                                        <TextBlock Text="Toggle grid" />
                                                    </ToolTip>
                                                </ToggleButton.ToolTip>
                                                <Image Width="14" Source="/FrostyEditor;component/Images/Grid.png"/>
                                            </ToggleButton>

                                            <Border Style="{StaticResource ToolbarSeparator}"/>

                                            <TextBlock Text="LOD:" VerticalAlignment="Center"
                                                       Margin="0,0,6,0" Foreground="#A0A0A0"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="PART_LodCombo"
                                                      Height="22" Width="60" Padding="4,2"
                                                      FontSize="12" Background="#1E1E1E"
                                                      Foreground="White" BorderBrush="#3F3F46"/>

                                            <Border Style="{StaticResource ToolbarSeparator}"/>

                                            <TextBlock Text="View:" VerticalAlignment="Center"
                                                       Margin="0,0,6,0" Foreground="#A0A0A0"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="PART_RenderModeCombo"
                                                      Height="22" Width="120" Padding="4,2"
                                                      FontSize="12" Background="#1E1E1E"
                                                      Foreground="White" BorderBrush="#3F3F46">
                                                <ComboBoxItem Content="Default Lit" IsSelected="True"/>
                                                <ComboBoxItem Content="Wireframe"/>
                                                <ComboBoxItem Content="BaseColor"/>
                                                <ComboBoxItem Content="SpecularColor"/>
                                                <ComboBoxItem Content="Normals"/>
                                                <ComboBoxItem Content="MaterialAO"/>
                                                <ComboBoxItem Content="Smoothness"/>
                                                <ComboBoxItem Content="Metallic"/>
                                                <ComboBoxItem Content="Reflectance"/>
                                            </ComboBox>

                                            <Border Style="{StaticResource ToolbarSeparator}"/>

                                            <ToggleButton x:Name="PART_SkeletonOverrideBtn"
                                                          Style="{StaticResource ToolbarToggle}">
                                                <ToggleButton.ToolTip>
                                                    <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                             Foreground="White" Padding="6,4"
                                                             ToolTipService.HasDropShadow="False">
                                                        <TextBlock Text="Override skeleton mode" />
                                                    </ToolTip>
                                                </ToggleButton.ToolTip>
                                                <Image Source="/FrostyCore;component/Images/Assets/SkeletonFileType.png"
                                                       Width="16" Height="16"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </ToggleButton>

                                            <ToggleButton x:Name="PART_PreviewSkeletonBtn"
                                                          Style="{StaticResource ToolbarToggle}">
                                                <ToggleButton.ToolTip>
                                                    <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                             Foreground="White" Padding="6,4"
                                                             ToolTipService.HasDropShadow="False">
                                                        <TextBlock Text="Preview Skeleton" />
                                                    </ToolTip>
                                                </ToggleButton.ToolTip>
                                                <Grid Width="16" Height="16">
                                                    <Image Source="/AssetBankPlugin;component/Images/Eye.png"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <Line X1="1" Y1="13" X2="13" Y2="1"
                                                          Stroke="#E0E0E0" StrokeThickness="1.5">
                                                        <Line.Style>
                                                            <Style TargetType="Line">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Line.Style>
                                                    </Line>
                                                </Grid>
                                            </ToggleButton>

                                            <Border Style="{StaticResource ToolbarSeparator}"/>

                                            <ToggleButton x:Name="PART_InstancesBtn"
                                                          Style="{StaticResource ToolbarToggle}">
                                                <ToggleButton.ToolTip>
                                                    <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                             Foreground="White" Padding="6,4"
                                                             ToolTipService.HasDropShadow="False">
                                                        <TextBlock Text="Instances" />
                                                    </ToolTip>
                                                </ToggleButton.ToolTip>
                                                <Image Source="/AssetBankPlugin;component/Images/Instances.png"
                                                       Width="16" Height="16"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </ToggleButton>

                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <Border Grid.Row="2" BorderBrush="#111" BorderThickness="0,0,1,0">
                                    <fcore:FrostyViewport x:Name="PART_Viewport"/>
                                </Border>

                                <Border Grid.Row="3" Background="#181818" BorderBrush="#2D2D30"
                                        BorderThickness="0,1,1,0" Padding="12,6,12,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Slider x:Name="PART_TimelineSlider" Grid.Row="0" Margin="0,0,0,8"
                                                Minimum="0" Maximum="100" Value="0"
                                                VerticalAlignment="Center" Height="24"
                                                IsMoveToPointEnabled="True">
                                            <Slider.ToolTip>
                                                <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                             Foreground="White" Padding="6,4"
                                                             ToolTipService.HasDropShadow="False">
                                                    <TextBlock Text="Animation frame scrub" />
                                                </ToolTip>
                                            </Slider.ToolTip>
                                        </Slider>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="FRAME" Foreground="#666"
                                                               FontSize="11" FontWeight="Bold"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Border Background="#222" BorderBrush="#333"
                                                            BorderThickness="1" CornerRadius="3"
                                                            Padding="2" MinWidth="45">
                                                        <TextBlock x:Name="PART_FrameLabel" Text="0"
                                                                   Foreground="#00A2FF" Background="Transparent"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="/" Foreground="#666" FontSize="13"
                                                               VerticalAlignment="Center" Margin="6,0"/>
                                                    <TextBlock x:Name="PART_TotalFramesLabel" Text="100"
                                                               Foreground="#999" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <Button x:Name="PART_RestartBtn"
                                                        HorizontalAlignment="Right" Margin="0,0,8,0"
                                                        Style="{StaticResource TransportButton}">
                                                    <Button.ToolTip>
                                                        <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                                     Foreground="White" Padding="6,4"
                                                                     ToolTipService.HasDropShadow="False">
                                                            <TextBlock Text="Restart" />
                                                        </ToolTip>
                                                    </Button.ToolTip>
                                                    <Viewbox Width="14" Height="14">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Stroke="#CCC" StrokeThickness="2.2" Fill="Transparent"
                                                                  Data="M 12,4 A 8,8 0 1 0 20,12"/>
                                                            <Path Fill="#CCC" Data="M 12,1 L 12,7 L 8,4 Z"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </Grid>

                                            <ToggleButton x:Name="PART_PlayPauseBtn" Grid.Column="1"
                                                          IsChecked="True"
                                                          Width="32" Height="32" Background="#252525" Cursor="Hand">
                                                <ToggleButton.ToolTip>
                                                    <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                             Foreground="White" Padding="6,4"
                                                             ToolTipService.HasDropShadow="False">
                                                        <TextBlock Text="Play / Pause" />
                                                    </ToolTip>
                                                </ToggleButton.ToolTip>
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                CornerRadius="3" Padding="6"
                                                                BorderBrush="#333" BorderThickness="1">
                                                            <Grid>
                                                                <Viewbox x:Name="PlayIcon" Width="14" Height="14"
                                                                         Visibility="Collapsed" Margin="2,0,0,0">
                                                                    <Canvas Width="24" Height="24">
                                                                        <Path Fill="#E0E0E0" Data="M 7,4 L 7,20 L 20,12 Z"/>
                                                                    </Canvas>
                                                                </Viewbox>
                                                                <Viewbox x:Name="PauseIcon" Width="14" Height="14">
                                                                    <Canvas Width="24" Height="24">
                                                                        <Path Fill="#E0E0E0" Data="M 7,4 L 7,20 L 10,20 L 10,4 Z M 14,4 L 14,20 L 17,20 L 17,4 Z"/>
                                                                    </Canvas>
                                                                </Viewbox>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#353535"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#444"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="PlayIcon"  Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="PauseIcon" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="False">
                                                                <Setter TargetName="PlayIcon"  Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="PauseIcon" Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="SPEED" Foreground="#666"
                                                           FontSize="11" FontWeight="Bold"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Slider x:Name="PART_SpeedSlider" Width="90"
                                                        Minimum="0.1" Maximum="3.0" Value="1.0"
                                                        SmallChange="0.1" LargeChange="0.5"
                                                        VerticalAlignment="Center"
                                                        IsSnapToTickEnabled="False">
                                                    <Slider.ToolTip>
                                                        <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                                     Foreground="White" Padding="6,4"
                                                                     ToolTipService.HasDropShadow="False">
                                                            <TextBlock Text="Playback speed multiplier" />
                                                        </ToolTip>
                                                    </Slider.ToolTip>
                                                </Slider>
                                                <Border Background="#222" BorderBrush="#333"
                                                        BorderThickness="1" CornerRadius="3"
                                                        Padding="2" MinWidth="40" Margin="8,0,0,0">
                                                    <TextBlock x:Name="PART_SpeedLabel" Text="1.0x"
                                                               Foreground="#CCC" Background="Transparent"
                                                               FontSize="12" FontWeight="Medium"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                          Background="#181818" BorderThickness="1,0" BorderBrush="#111"/>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#252526" BorderBrush="#111"
                                        BorderThickness="0,0,0,1" Padding="8,8,8,6">
                                    <StackPanel>
                                        <TextBlock Text="ASSET LIBRARY" Foreground="#888888"
                                                   FontSize="11" FontWeight="Bold" Margin="2,0,0,6"/>
                                        <Border Background="#1E1E1E" CornerRadius="4" BorderBrush="#3F3F46" BorderThickness="1" Height="26">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Filter Button -->
                                                <ToggleButton x:Name="PART_FilterButton" Style="{StaticResource ToolbarToggle}"
                                                    Width="22" Height="22" Margin="2,0,4,0" VerticalAlignment="Center">
                                                    <ToggleButton.ToolTip>
                                                        <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" Foreground="White" Padding="6,4">
                                                            <TextBlock Text="Filter and sort asset list" />
                                                        </ToolTip>
                                                    </ToggleButton.ToolTip>
                                                    <Image Source="/FrostyEditor;component/Images/Filter.png" Width="12" Height="12" Opacity="0.8"/>
                                                </ToggleButton>

                                                <!-- Filter Options Popup -->
                                                <Popup x:Name="PART_FilterPopup"
                                                      PlacementTarget="{Binding ElementName=PART_FilterButton}"
                                                      Placement="Bottom" VerticalOffset="4" HorizontalOffset="-2"
                                                      StaysOpen="False">
                                                    <win:AssetFilterMenu x:Name="PART_FilterMenu"/>
                                                </Popup>

                                                <ctrl:FrostyWatermarkTextBox x:Name="PART_SearchBox" Grid.Column="1"
                                                   VerticalContentAlignment="Center" WatermarkText="Search assets or GUIDs…"
                                                   Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" Padding="0,0,8,0" FontSize="12"/>
                                            </Grid>
                                        </Border>

                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Background="{StaticResource ListBackground}"
                                        BorderBrush="#111" BorderThickness="0">
                                    <TreeView x:Name="PART_AssetTreeView"
                                              Background="Transparent" BorderThickness="0" Margin="4"
                                              VirtualizingStackPanel.IsVirtualizing="True"
                                              VirtualizingStackPanel.VirtualizationMode="Recycling">

                                        <TreeView.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#303030"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#007ACC"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="White"/>

                                            <HierarchicalDataTemplate DataType="{x:Type local:AntTypeGroup}"
                                                                       ItemsSource="{Binding Assets}">
                                                <Border Margin="0,2" BorderBrush="#333"
                                                        BorderThickness="0,0,0,1" MinHeight="26">
                                                    <StackPanel Orientation="Horizontal" Margin="2,-4,2,4">
                                                        <TextBlock Text="{Binding TypeName}"
                                                                   Foreground="#E0E0E0" FontWeight="SemiBold"
                                                                   FontSize="13" VerticalAlignment="Center"
                                                                   TextOptions.TextFormattingMode="Display"/>
                                                        <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                                   Foreground="#00A2FF" FontSize="12"
                                                                   VerticalAlignment="Center" FontWeight="Medium"
                                                                   TextOptions.TextFormattingMode="Display"/>
                                                    </StackPanel>
                                                </Border>
                                            </HierarchicalDataTemplate>

                                            <HierarchicalDataTemplate DataType="{x:Type local:AntAssetViewModel}"
                                                                       ItemsSource="{Binding Properties}">
                                                <Grid Margin="3,3,0,3" Background="Transparent">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Copy GUID" Command="{Binding CopyGuidCommand}">
                                                                <MenuItem.Icon>
                                                                    <Image Source="/FrostyCore;component/Images/Copy.png" Width="14" Height="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Export Animation"
                                                                      Command="{Binding ExportCommand}"
                                                                      Visibility="{Binding ExportVisibility}">
                                                                <MenuItem.Icon>
                                                                    <Image Source="/FrostyEditor;component/Images/Export.png" Width="14" Height="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Export Rig + Mesh…"
                                                                      Command="{Binding ExportRigMeshCommand}"
                                                                      Visibility="{Binding ExportRigMeshVisibility}">
                                                                <MenuItem.Icon>
                                                                    <Image Source="/FrostyEditor;component/Images/Export.png" Width="14" Height="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Import Animation"
                                                                      Command="{Binding ImportAnimationCommand}"
                                                                      Visibility="{Binding ImportAnimVisibility}">
                                                                <MenuItem.Icon>
                                                                    <Image Source="/FrostyEditor;component/Images/Import.png" Width="14" Height="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Duplicate"
                                                                      Command="{Binding DuplicateCommand}"
                                                                      Visibility="{Binding DuplicateVisibility}">
                                                                <MenuItem.Icon>
                                                                    <Image Source="/FrostyEditor;component/Images/Add.png" Width="14" Height="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Show Tree"
                                                                      Command="{Binding ShowTreeCommand}"
                                                                      Visibility="{Binding ShowTreeVisibility}">
                                                                <MenuItem.Icon>
                                                                    <Image Source="/AssetBankPlugin;component/Images/Eye.png" Width="14" Height="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Edit Anim Assets…"
                                                                      Command="{Binding EditAnimAssetsCommand}"
                                                                      Visibility="{Binding EditAnimAssetsVisibility}">
                                                                <MenuItem.Icon>
                                                                    <Image Source="/FrostyEditor;component/Images/Export.png" Width="14" Height="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Revert"
                                                                      Command="{Binding RevertCommand}"
                                                                      Visibility="{Binding RevertVisibility}">
                                                                <MenuItem.Icon>
                                                                    <Image Source="/FrostyEditor;component/Images/Revert.png" Width="14" Height="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Debug: Test Compressor"
                                                                      Command="{Binding TestCompressorCommand}"
                                                                      Visibility="{Binding TestCompressorVisibility}">
                                                                <MenuItem.Icon>
                                                                    <Image Source="/FrostyEditor;component/Images/Interface.png" Width="14" Height="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="220"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelectedForExport}"
                                                              Visibility="{Binding CheckboxVisibility}"
                                                              Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                               Foreground="White" FontSize="12"
                                                               FontWeight="{Binding NameFontWeight}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,12,0" VerticalAlignment="Center"
                                                               TextOptions.TextFormattingMode="Display"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Id}"
                                                               Foreground="#888888" VerticalAlignment="Center"
                                                               FontSize="12" FontFamily="Consolas"
                                                               TextOptions.TextFormattingMode="Display"/>
                                                </Grid>
                                            </HierarchicalDataTemplate>
                                            <HierarchicalDataTemplate DataType="{x:Type local:AntPropertyViewModel}"
                                                                       ItemsSource="{Binding Children}">
                                                <Grid Margin="3,2,0,2" Background="Transparent">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Insert Before" 
                                                                      Command="{Binding InsertBeforeCommand}" 
                                                                      Visibility="{Binding ArrayElementVisibility}">
                                                                <MenuItem.Icon>
                                                                    <Image Source="/FrostyEditor;component/Images/Add.png" Width="14" Height="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>

                                                            <MenuItem Header="Insert After" 
                                                                      Command="{Binding InsertAfterCommand}" 
                                                                      Visibility="{Binding ArrayElementVisibility}">
                                                                <MenuItem.Icon>
                                                                    <Image Source="/FrostyEditor;component/Images/Add.png" Width="14" Height="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>

                                                            <MenuItem Header="Delete Element" 
                                                                      Command="{Binding DeleteCommand}" 
                                                                      Visibility="{Binding ArrayElementVisibility}">
                                                                <MenuItem.Icon>
                                                                    <Image Source="/FrostyEditor;component/Images/Clear.png" Width="14" Height="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>

                                                            <Separator Visibility="{Binding ArrayElementVisibility}"/>

                                                            <MenuItem Header="Copy Value" Command="{Binding CopyValueCommand}">
                                                                <MenuItem.Icon>
                                                                    <Image Source="/FrostyCore;component/Images/Copy.png" Width="14" Height="14"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="#BBBBBB" FontSize="12"
                                                               ToolTip="{Binding TypeStr}"
                                                               VerticalAlignment="Center"
                                                               TextOptions.TextFormattingMode="Display"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueStr}"
                                                               Foreground="#00CE9B" FontSize="12"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                               FontWeight="Medium"
                                                               Visibility="{Binding ReadOnlyVisibility}"
                                                               TextOptions.TextFormattingMode="Display"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding EditedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent" Foreground="#00CE9B"
                                                             FontSize="12" FontWeight="Medium"
                                                             VerticalAlignment="Center"
                                                             BorderThickness="0,0,0,1" BorderBrush="#444"
                                                             Padding="2,0" CaretBrush="White"
                                                             SelectionBrush="#005580"
                                                             Visibility="{Binding EditableVisibility}"/>
                                                </Grid>
                                            </HierarchicalDataTemplate>
                                        </TreeView.Resources>

                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="{x:Type TreeViewItem}"
                                                   BasedOn="{StaticResource baseTreeViewItemStyle}">
                                                <Setter Property="IsExpanded" Value="False"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="4,2"/>
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                    </TreeView>
                                </Border>

                                <Border Grid.Row="2" Background="#252526" BorderBrush="#111"
                                        BorderThickness="0,1,0,0" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" x:Name="PART_AddRefButton"
                                                Style="{StaticResource SecondaryActionButton}"
                                                Margin="0,0,2,0">
                                            <Button.ToolTip>
                                                <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                             Foreground="White" Padding="6,4"
                                                             ToolTipService.HasDropShadow="False">
                                                    <TextBlock Text="Add Reference Banks" />
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/FrostyEditor;component/Images/Add.png"
                                                       Width="12" Height="12" Margin="0,0,4,0" Opacity="0.8"/>
                                                <TextBlock Text="Add Refs" VerticalAlignment="Center"
                                                           FontWeight="Medium" FontSize="11"/>
                                            </StackPanel>
                                        </Button>

                                        <ToggleButton Grid.Column="1" x:Name="PART_BulkToggle"
                                                      Style="{StaticResource ActionToggleButton}"
                                                      Margin="2,0,2,0">
                                            <ToggleButton.ToolTip>
                                                <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                             Foreground="White" Padding="6,4"
                                                             ToolTipService.HasDropShadow="False">
                                                    <TextBlock Text="Multi-Select Mode" />
                                                </ToolTip>
                                            </ToggleButton.ToolTip>
                                            <TextBlock Text="Multi-Select" VerticalAlignment="Center"
                                                       FontWeight="Medium" FontSize="11"/>
                                        </ToggleButton>

                                        <Button Grid.Column="2" x:Name="PART_ExportBulkButton"
                                                Style="{StaticResource PrimaryActionButton}"
                                                Margin="2,0,2,0"
                                                IsEnabled="{Binding IsExportEnabled, RelativeSource={RelativeSource TemplatedParent}}">
                                            <Button.ToolTip>
                                                <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                             Foreground="White" Padding="6,4"
                                                             ToolTipService.HasDropShadow="False">
                                                    <TextBlock Text="Export selected animations" />
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/FrostyEditor;component/Images/Export.png"
                                                       Width="12" Height="12" Margin="0,0,4,0"/>
                                                <TextBlock Text="Export" VerticalAlignment="Center"
                                                           FontWeight="Medium" FontSize="11"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="3" x:Name="PART_SaveButton"
                                                Style="{StaticResource PrimaryActionButton}"
                                                Margin="2,0,0,0">
                                            <Button.ToolTip>
                                                <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                             Foreground="White" Padding="6,4"
                                                             ToolTipService.HasDropShadow="False">
                                                    <TextBlock Text="Save changes to the selected asset and write back to the bank res" />
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <TextBlock Text="Save" VerticalAlignment="Center"
                                                       FontWeight="Medium" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <Popup x:Name="PART_MeshListPopup"
                               PlacementTarget="{Binding ElementName=PART_InstancesBtn}"
                               Placement="Bottom" VerticalOffset="3"
                               IsOpen="{Binding IsChecked, ElementName=PART_InstancesBtn, Mode=TwoWay}"
                               StaysOpen="True" Width="290">
                            <Border Background="#1E1E1E" BorderBrush="#3F3F46"
                                    BorderThickness="1" CornerRadius="4" Margin="4,0,4,6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="3"
                                                      Direction="270" Opacity="0.55" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Background="#252526" CornerRadius="4,4,0,0"
                                            Padding="10,7" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Text="LOADED MESHES" Foreground="#888"
                                                       FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button HorizontalAlignment="Right" Width="20" Height="20" Padding="0"
                                                    Command="{Binding AddMeshFromExplorerCommand}"
                                                    Style="{StaticResource SecondaryActionButton}">
                                                <Button.ToolTip>
                                                    <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                                 Foreground="White" Padding="6,4"
                                                                 ToolTipService.HasDropShadow="False">
                                                        <TextBlock Text="Add asset selected in data explorer as a new mesh" />
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,-1,0,0"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding LoadedMeshes}" MaxHeight="320">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,4" Background="Transparent">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#252526"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <ToggleButton Grid.Column="0"
                                                                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                      Width="22" Height="22" Margin="0,0,6,0"
                                                                      VerticalAlignment="Center" Cursor="Hand">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="Bd" Background="Transparent"
                                                                            CornerRadius="3" Padding="3">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                            <Grid Width="16" Height="16">
                                                                <Image Source="/AssetBankPlugin;component/Images/Eye.png"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                <Line X1="1" Y1="13" X2="13" Y2="1"
                                                                      Stroke="#E0E0E0" StrokeThickness="1.5">
                                                                    <Line.Style>
                                                                        <Style TargetType="Line">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Line.Style>
                                                                </Line>
                                                            </Grid>
                                                        </ToggleButton>

                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   Foreground="#E0E0E0" FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}"/>

                                                        <Button Grid.Column="2" Width="22" Height="22"
                                                                Margin="6,0,0,0"
                                                                Command="{Binding UseSelectedCommand}"
                                                                VerticalAlignment="Center" Cursor="Hand"
                                                                Style="{StaticResource SecondaryActionButton}" Padding="0">
                                                            <Button.ToolTip>
                                                                <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                                             Foreground="White" Padding="6,4"
                                                                             ToolTipService.HasDropShadow="False">
                                                                    <TextBlock Text="Replace with asset selected in data explorer" />
                                                                </ToolTip>
                                                            </Button.ToolTip>
                                                            <Image Width="12" Height="12"
                                                                   Source="/FrostyEditor;component/Images/Assign.png"
                                                                   RenderTransformOrigin="0.5,0.5">
                                                                <Image.RenderTransform>
                                                                    <ScaleTransform ScaleX="-1"/>
                                                                </Image.RenderTransform>
                                                            </Image>
                                                        </Button>

                                                        <Button Grid.Column="3" Width="20" Height="20"
                                                                Margin="4,0,0,0"
                                                                Command="{Binding RemoveCommand}"
                                                                VerticalAlignment="Center" Cursor="Hand"
                                                                Style="{StaticResource SecondaryActionButton}" Padding="0">
                                                            <Button.ToolTip>
                                                                <ToolTip Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1"
                                                                             Foreground="White" Padding="6,4"
                                                                             ToolTipService.HasDropShadow="False">
                                                                    <TextBlock Text="Remove this mesh" />
                                                                </ToolTip>
                                                            </Button.ToolTip>
                                                            <TextBlock Text="X" FontSize="11" FontWeight="Bold"
                                                                       Foreground="#CC4444" Margin="0,-1,0,0"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="No meshes loaded" Foreground="#555" FontSize="12"
                                               HorizontalAlignment="Center" Padding="10,14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LoadedMeshes.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Border x:Name="PART_LoadingOverlay" Background="#AA000000"
                                Panel.ZIndex="10" Visibility="Collapsed">
                            <Border Background="#1E1E1E" BorderBrush="#333" BorderThickness="1"
                                    CornerRadius="6" Padding="35"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="260">
                                <StackPanel>
                                    <ctrl:FrostySpinner Width="45" Height="45" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PART_LoadingText" Text="Parsing AntState Bank…"
                                               Foreground="#E0E0E0" FontSize="14"
                                               Margin="0,18,0,0" HorizontalAlignment="Center"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </Border>
                        </Border>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
