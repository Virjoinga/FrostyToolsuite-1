<UserControl x:Class="AssetBankPlugin.Windows.AssetFilterMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220">

    <!-- STYLES -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AssetBankPlugin;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header Bar -->
            <Border Background="#252526" CornerRadius="4,4,0,0" Padding="10,6" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="FILTER &amp; SORT" Foreground="#888888" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="PART_BtnReset" Content="Reset" HorizontalAlignment="Right" 
                            Style="{StaticResource SecondaryActionButton}" FontSize="11"/>
                </Grid>
            </Border>

            <!-- Options -->
            <Border Padding="10,8">
                <StackPanel>
                    <TextBlock Text="FILTERS" Foreground="#AAAAAA" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <ToggleButton x:Name="PART_ChkModifiedOnly" Content="Show Modified Only" 
                                  Style="{StaticResource ActionToggleButton}" 
                                  Margin="0,0,0,6" HorizontalAlignment="Stretch"/>

                    <ToggleButton x:Name="PART_ChkAnimationsOnly" Content="Show Animations Only" 
                                  Style="{StaticResource ActionToggleButton}" 
                                  Margin="0,0,0,8" HorizontalAlignment="Stretch"/>

                    <Border Height="1" Background="#333333" Margin="0,4,0,8"/>

                    <TextBlock Text="SORT ORDER" Foreground="#AAAAAA" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <!-- Sort Order -->
                    <ToggleButton x:Name="PART_TogSortOrder" Height="26" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="#151515" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- The Sliding Thumb -->
                                        <Border x:Name="ActiveThumb" Grid.Column="0" 
                                                Background="#2D2D30" BorderBrush="#3F3F46" 
                                                BorderThickness="1" CornerRadius="3" Margin="2">
                                        </Border>

                                        <TextBlock x:Name="TextAsc" Grid.Column="0" Text="Name (A - Z)" 
                                                   Foreground="#E0E0E0" FontSize="11" FontWeight="Medium" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                                        <TextBlock x:Name="TextDesc" Grid.Column="1" Text="Name (Z - A)" 
                                                   Foreground="#888888" FontSize="11" FontWeight="Medium" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- A to Z State (Unchecked) -->
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="ActiveThumb" Property="Grid.Column" Value="0"/>
                                        <Setter TargetName="ActiveThumb" Property="Background" Value="#1C3852"/>
                                        <Setter TargetName="ActiveThumb" Property="BorderBrush" Value="#007ACC"/>
                                        <Setter TargetName="TextAsc" Property="Foreground" Value="#44AAFF"/>
                                        <Setter TargetName="TextDesc" Property="Foreground" Value="#888888"/>
                                    </Trigger>

                                    <!-- Z to A State (Checked) -->
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="ActiveThumb" Property="Grid.Column" Value="1"/>
                                        <Setter TargetName="ActiveThumb" Property="Background" Value="#1C3852"/>
                                        <Setter TargetName="ActiveThumb" Property="BorderBrush" Value="#007ACC"/>
                                        <Setter TargetName="TextAsc" Property="Foreground" Value="#888888"/>
                                        <Setter TargetName="TextDesc" Property="Foreground" Value="#44AAFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
