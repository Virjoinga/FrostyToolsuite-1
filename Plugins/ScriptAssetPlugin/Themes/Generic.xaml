<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Frosty.Core.Controls;assembly=FrostyCore"
    xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
    xmlns:lcatrl="clr-namespace:ScriptAssetPlugin.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:fdev="FrostyDeveloper">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostyControls;component/Themes/Generic.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="{x:Type lcatrl:ScriptAssetEditor}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type lcatrl:ScriptAssetEditor}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <ctrl:FrostyDockablePanel Grid.Column="0" Title="" TitleBarVisible="False">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Margin="1">
                                    <DockPanel>
                                        <TextBlock x:Name="PART_FieldNameBlock" Text="Script" Padding="7,2,0,0" HorizontalAlignment="Stretch" Background="{StaticResource ControlBackground}" FontSize="14" Height="900">
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                                <Grid Grid.Row="1" x:Name="bkgnd" Background="Black">
                                    <TextBox x:Name="PART_ScriptTextBox" Background="Black" FontFamily="Consolas" TextWrapping="Wrap" FontSize="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto">
                                    </TextBox>
                                </Grid>
                            </Grid>
                        </ctrl:FrostyDockablePanel>
                        <GridSplitter Grid.Column="1" Width="3" VerticalAlignment="Stretch" Background="Transparent" HorizontalAlignment="Left"/>
                        <ctrl:FrostyDockablePanel Grid.Column="1" Title="Properties" Icon="/FrostyEditor;component/Images/Properties.png" Margin="3,0,0,0">
                            <core:FrostyPropertyGrid x:Name="PART_AssetPropertyGrid" Asset="{Binding Asset, RelativeSource={RelativeSource TemplatedParent}}" Modified="{Binding AssetModified, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </ctrl:FrostyDockablePanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>